---
// Editorial hero. Headline lands first; the full needle threads in from the
// left, dividing the headline from the body copy; then sub + CTAs reveal.
---

<section class="section section--no-rule section--xl hero" id="top">
  <div class="container">
    <h1 class="t-display hero__headline">
      Focused companies.<br />
      <em>Carefully built.</em>
    </h1>

    <div class="hero-needle" aria-hidden="true">
      <picture>
        <source srcset="/brand/highstack-needle-full-yellow.png" media="(prefers-color-scheme: dark)" />
        <img src="/brand/highstack-needle-full-black.png" alt="" />
      </picture>
    </div>

    <p class="t-body-lg hero__sub reveal">
      Highstack creates, owns, and operates a small portfolio of focused businesses. We build
      with clear strategy, disciplined economics, and the patience to compound durable value
      over the long term.
    </p>

    <div class="hero__ctas reveal">
      <a class="btn btn--primary btn--lg" href="/portfolio">The portfolio</a>
      <a class="btn btn--secondary btn--lg" href="/about">How we build</a>
    </div>
  </div>
</section>

<style>
  .hero__headline {
    margin: 0;
    max-width: 14ch;
  }
  .hero__headline em {
    font-style: italic;
    color: var(--fg-secondary);
    font-weight: inherit;
  }
  .hero__sub {
    margin-top: 0;
    color: var(--fg-secondary);
    max-width: 56ch;
  }
  .hero__ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: var(--s-7);
  }
</style>
