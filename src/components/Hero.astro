---
// Editorial hero. Headline lands first; the full needle threads in from the
// left, dividing the headline from the body copy; then sub + CTAs reveal.
---

<section class="section section--no-rule section--xl hero" id="top">
  <div class="container">
    <h1 class="t-display hero__headline">
      Focused companies.<br />
      <em>Carefully built.</em>
    </h1>

    <div class="hero-needle" aria-hidden="true">
      <picture>
        <source srcset="/brand/highstack-needle-full-yellow.png" media="(prefers-color-scheme: dark)" />
        <img src="/brand/highstack-needle-full-black.png" alt="" />
      </picture>
    </div>

    <p class="t-body-lg hero__sub reveal">
      Highstack creates, owns, and operates a strategic portfolio of focused businesses. We build
      with clear strategy, disciplined economics, and the patience to compound durable value
      over the long term.
    </p>

    <div class="hero__ctas reveal">
      <a class="btn btn--primary btn--lg" href="#approach">How we build</a>
      <a class="btn btn--secondary btn--lg" href="#numbers">By the numbers</a>
    </div>
  </div>
</section>

<script>
  // Size the threading needle to the rendered width of the display headline,
  // so it ends end-to-end with "Carefully built." at any viewport — including
  // breakpoints where the headline doesn't fill the container.
  const syncNeedle = () => {
    // Measure "Carefully built." (the italic em on line 2), not the whole
    // headline — at wider viewports "Focused companies." is longer and we
    // specifically want the needle to end with "Carefully built."
    const target = document.querySelector<HTMLElement>(".hero__headline em");
    const needle = document.querySelector<HTMLElement>(".hero-needle");
    if (!target || !needle) return;
    const range = document.createRange();
    range.selectNodeContents(target);
    const w = range.getBoundingClientRect().width;
    if (w > 0) needle.style.maxWidth = `${Math.round(w)}px`;
  };
  syncNeedle();
  window.addEventListener("resize", syncNeedle);
  // Re-run after fonts swap in — Newsreader's actual metrics differ from fallback
  if (document.fonts?.ready) document.fonts.ready.then(syncNeedle);
</script>

<style>
  .hero__headline {
    margin: 0;
    max-width: 14ch;
  }
  .hero__headline em {
    font-style: italic;
    color: var(--fg-secondary);
    font-weight: inherit;
  }
  .hero__sub {
    margin-top: 0;
    color: var(--fg-secondary);
    max-width: 56ch;
  }
  .hero__ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: var(--s-7);
  }

  /* Below 480px the buttons stack and stretch — looks intentional rather
     than stranded at different widths. */
  @media (max-width: 480px) {
    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .hero__ctas :global(.btn) {
      width: 100%;
    }
  }
</style>

