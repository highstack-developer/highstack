---
const items = [
  { id: "approach", label: "Approach", href: "/#approach" },
  { id: "numbers", label: "Numbers", href: "/#numbers" },
  { id: "subscribe", label: "Notes", href: "/#subscribe" },
];
---

<header class="site-header">
  <a href="/" class="site-header__lockup" aria-label="Highstack — home">
    <picture>
      <source srcset="/brand/highstack-wordmark-white.png" media="(prefers-color-scheme: dark)" />
      <img src="/brand/highstack-wordmark-black.png" alt="Highstack" />
    </picture>
  </a>

  <nav class="site-header__nav" aria-label="Primary">
    {
      items.map((it) => (
        <a href={it.href} data-id={it.id}>
          {it.label}
        </a>
      ))
    }
    <span aria-hidden="true" class="site-header__nav-underline"></span>
  </nav>
</header>

<style is:global>
  /* Override the design system's mobile rule that hides nav below 768px.
     We keep the inline nav visible at every width — no hamburger. */
  @media (max-width: 768px) {
    .site-header { padding: 14px var(--grid-margin); gap: var(--s-4); }
    .site-header__nav { display: flex !important; gap: var(--s-5); }
    .site-header__lockup img { height: 24px; }
  }
  @media (max-width: 480px) {
    .site-header { padding: 12px var(--s-4); gap: var(--s-3); }
    .site-header__nav { gap: var(--s-3); }
    .site-header__nav a { font-size: 13px; }
  }

  /* Progressive label hiding for hyper-narrow viewports.
     Real phones are 320px+ → all 3 labels remain visible.
     Below 320px (browser-resize zone / folded foldables) items
     drop off from the right to keep the layout intentional. */
  @media (max-width: 319px) {
    .site-header__nav a[data-id="subscribe"] { display: none; }
  }
  @media (max-width: 269px) {
    .site-header__nav a[data-id="numbers"] { display: none; }
  }
  @media (max-width: 219px) {
    .site-header__nav a[data-id="approach"] { display: none; }
  }
</style>

<script>
  // Sliding underline that follows the hovered/focused nav item.
  const nav = document.querySelector<HTMLElement>(".site-header__nav");
  const underline = nav?.querySelector<HTMLElement>(".site-header__nav-underline");
  if (nav && underline) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>("a"));

    const position = (target: HTMLElement | null) => {
      if (!target) {
        underline.style.opacity = "0";
        return;
      }
      const navBox = nav.getBoundingClientRect();
      const elBox = target.getBoundingClientRect();
      underline.style.left = `${elBox.left - navBox.left}px`;
      underline.style.width = `${elBox.width}px`;
      underline.style.opacity = "1";
    };

    for (const a of links) {
      a.addEventListener("mouseenter", () => position(a));
      a.addEventListener("focus", () => position(a));
    }
    nav.addEventListener("mouseleave", () => position(null));
    nav.addEventListener("focusout", () => position(null));
  }
</script>
